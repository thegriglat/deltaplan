; Engine configuration file.

config_version=5

[application]

config/name="Deltaplan"
config/description="Симулятор дельтаплана"
config/version="1.3.2"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="Deltaplan"
boot_splash/bg_color=Color(0.306, 0.341, 0.41, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/stretch_mode=4

[audio]

buses/default_bus_layout="res://scenes/audio/bus_layout.tres"

[autoload]

Config="*res://scripts/core/config.gd"
SteamService="*res://scripts/steam/steam_service.gd"
Achievements="*res://scripts/steam/achievements.gd"
Activity="*res://scripts/core/activity.gd"
SteamPresence="*res://scripts/steam/steam_presence.gd"
NetClient="*res://scripts/net/net_client.gd"
NetZone="*res://scripts/net/net_zone.gd"
NetPilots="*res://scripts/net/net_pilots.gd"
LanDiscovery="*res://scripts/net/lan_discovery.gd"
SteamLobby="*res://scripts/steam/steam_lobby.gd"

[debug]


[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[gui]

theme/custom="res://scenes/ui/theme.tres"

[input]

cycle_debug_menu={
"deadzone": 0.2,
"events": []
}

[internationalization]

locale/translations=PackedStringArray("res://locale/ui.ru.translation", "res://locale/ui.en.translation")
locale/fallback="en"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16

[rendering]
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true

[shader_globals]

cloud_shadow_map={
"type": "sampler2D",
"value": ""
}
cloud_shadow_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_shadow_sun={
"type": "vec4",
"value": Vector4(0, 0, 0, 0.15)
}
cloud_shadow_sky={
"type": "float",
"value": 0.0
}
