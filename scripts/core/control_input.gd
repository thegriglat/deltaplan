class_name ControlInput
extends RefCounted
## Управление пилота за один шаг физики. Источник (клавиатура/мышь/геймпад) не важен.
## Смысл полей по фазам — контракт С1 v2 (docs/contracts/control-fix.md).

## Трапеция по тангажу: +1 — полностью от себя (нос вверх, торможение),
## −1 — на себя (разгон), 0 — нейтраль (трим).
## На земле (стоя, шагом, на бегу) — нос крыла, тот же смысл и знак, полный ход.
var pitch: float = 0.0
## Крен, + вправо. В полёте: Игрок («Маятник») — положение пилота; боты (FlightModel) — скорость крена.
## На земле (стоя, шагом, на бегу) — заданный крен крыла «рукой пилота»:
## ±1 — предельный крен руки flight.json → ground_bank.command_max_deg. Курс не задаёт.
var roll: float = 0.0
## Разбег (зажат Shift): пилот бежит. Используется только на земле.
var run: bool = false
## Ходьба на земле без разбега: +1 — шаг вперёд, −1 — назад, 0 — стоит.
var walk: float = 0.0
## Поворот курса на земле стоя и шагом: +1 — вправо (по часовой) с pilot.walk.turn_rate_dps,
## −1 — влево. В полёте и на бегу не используется (на бегу курс — от крена крыла).
var turn: float = 0.0
## Добор «на себя» до бёдер (VM-К3 v2): зажат модификатор (Shift, кнопка геймпада gamepad.pull_full_button;
## самодельная трапеция — пока тангаж с неё). В полёте «Маятника» полный «на себя» — штанга у бёдер
## (arms.shift_x_pull_full_m) вместо груди; на земле и в FlightModel не читается.
var pull_full: bool = false
