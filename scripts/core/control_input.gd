class_name ControlInput
extends RefCounted
## Управление пилота за один шаг физики. Источник (клавиатура/мышь/геймпад) не важен.
## Смысл полей зависит от фазы (FR-30): в полёте / на земле / в разбеге.

## Трапеция по тангажу: +1 — полностью от себя (нос вверх, торможение), −1 — на себя (разгон), 0 — нейтраль (трим).
## В разбеге — угол носа крыла (та же логика: + нос вверх).
var pitch: float = 0.0
## Смещение веса по крену: +1 — вправо до упора, −1 — влево. На земле — поворот на месте / подруливание в разбеге.
var roll: float = 0.0
## Разбег (зажат Shift): пилот бежит. Используется только на земле.
var run: bool = false
## Ходьба на земле без разбега: +1 — шаг вперёд, −1 — назад, 0 — стоит.
var walk: float = 0.0
