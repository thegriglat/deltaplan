class_name SpeedHold
extends RefCounted
## Закон тангажа по воздушной скорости для пилота-автомата (TW-17, буксировка). Ввод тангажа pitch:
## < 0 — «на себя» (штанга к груди, ЦМ пилота вперёд, угол атаки меньше, трим быстрее), > 0 — «от себя».
## Закон — ПИ по ошибке скорости с D по измерению (ускорение dV/dt): без D прямая обратная связь V → ввод
## раскачивает фугоиду (обмен V и высоты, период ≈ 2π·V/(g·√2) ≈ 8–10 с при 12–16 м/с, затухание
## слабое), D по ускорению гасит её; упора по ходу пилота нет, пока цель в 12–16 м/с (TW-16: удержание
## тангажа вместо скорости разгоняет крыло за 20 м/с). Усиления подобраны на «Маятнике» sport (ввод −1 ≈
## +10 м/с трима) в свободном полёте и на лебёдочном тросе 400–800 Н, ε 20–60° (tests/flight/test_speed_hold.gd);
## граница: модель — квазистатика по V, без учёта порывов (болтанку не проверяли), крыло другого класса —
## свои усиления (чувствительность dV/d(ввод) у training/laminar другая).

## Цель, м/с.
var target_ms := 14.0
## Ввод тангажа на м/с ошибки, на м/с·с и на м/с² (D по измерению); у крыла sport ввод −1 даёт ≈ +10 м/с.
var kp := 0.1
var ki := 0.05
var kd := 0.25
var _i := 0.0
var _v_prev := 0.0
var _dv := 0.0
var _first := true
var command := 0.0


func reset() -> void:
	_first = true
	_i = 0.0
	_dv = 0.0
	command = 0.0


## Ввод тангажа −1…1 по телеметрии за шаг dt.
func update(t: Telemetry, dt: float) -> float:
	var v := t.airspeed
	if _first:
		_first = false
		_v_prev = v
	if dt > 0.0:
		_dv = lerpf(_dv, (v - _v_prev) / dt, 0.1)
	_v_prev = v
	var e := target_ms - v  # медленнее цели → «на себя» (ввод < 0): штанга к груди, трим быстрее
	_i = clampf(_i + ki * e * dt, -1.0, 1.0)
	command = clampf(-(kp * e + _i - kd * _dv), -1.0, 1.0)
	return command
