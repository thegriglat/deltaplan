    {
      "name": "no_off_api",
      "cmd": "grep -rnE 'set_air_mode|set_field_enabled|settings_wind_model|air_model\\.enabled|\"enabled\": *\"(auto|on|off)\"' scripts rust/dp-air/src rust/dp-gd/src rust/dp-stand tests/core tests/ui tests/game tests/atmosphere tests/contracts locale configs/atmosphere.json tools/release --include=*.gd --include=*.rs --include=*.csv --include=*.json --include=*.txt | grep -vE '^scripts/atmosphere/(air_model/|wind_model\\.gd)' | wc -l",
      "expect": "num:^(\\d+) <=0"
    },
    {
      "name": "no_synth_off",
      "cmd": "test ! -e tests/fixtures/wind/cases/synth_off.json && ! grep -rq synth_off tests/fixtures/wind rust/dp-air/tests",
      "expect": "exit=0"
    },
    {
      "name": "no_off_rs",
      "cmd": "test ! -e rust/dp-air/src/terms/analytic/off.rs",
      "expect": "exit=0"
    },
    {
      "name": "cargo_test",
      "cmd": "cargo test --manifest-path rust/Cargo.toml --workspace",
      "expect": "exit=0"
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
      "expect": "exit=0"
    },
    {
      "name": "fmt",
      "cmd": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
      "expect": "exit=0"
    },
    {
      "name": "dp_air_no_godot",
      "cmd": "cargo tree --manifest-path rust/Cargo.toml -p dp-air -e normal | grep -ci godot || true",
      "expect": "num:^(\\d+) <=0"
    },
    {
      "name": "report_doc",
      "cmd": "test -s docs/research/rust-wind-stage3/no-off-mode.md",
      "expect": "exit=0"
    },
    {
