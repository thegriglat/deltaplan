  "accept": [
    {
      "name": "rust_wind_contracts",
      "tests": "rust_wind_contracts"
    },
    {
      "name": "purity",
      "cmd": "bash tools/dp_air_purity.sh | tail -1",
      "expect": "num:нарушений: (\\d+) <=0"
    },
    {
      "name": "cargo_test",
      "cmd": "cargo test --manifest-path rust/Cargo.toml --workspace",
      "expect": "exit=0"
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
      "expect": "exit=0"
    },
    {
      "name": "fmt",
      "cmd": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
      "expect": "exit=0"
    },
    {
      "name": "dp_air_no_godot",
      "cmd": "cargo tree --manifest-path rust/Cargo.toml -p dp-air -e normal | grep -ciE 'godot|brotli' || true",
      "expect": "num:^(\\d+) <=0"
    },
    {
      "name": "contracts_const",
      "cmd": "grep -cE 'W5 = 11,.*W12 = 3' tests/contracts/test_rust_wind_contracts.gd",
      "expect": "num:^(\\d+) >=1"
    },
    {
      "name": "no_unsafe",
      "cmd": "grep -rn 'unsafe' rust/dp-air/src | grep -v 'forbid(unsafe_code)' | wc -l",
      "expect": "num:^(\\d+) <=0"
    },
    {
      "name": "forbid",
      "cmd": "grep -c '^#!\\[forbid(unsafe_code)\\]' rust/dp-air/src/lib.rs",
      "expect": "num:^(\\d+) >=1"
    }
  ],
