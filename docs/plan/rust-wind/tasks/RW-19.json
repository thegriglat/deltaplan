  "accept": [
    {
      "name": "mv_count",
      "cmd": "grep -rho 'multiversion(targets' rust/dp-air/src | wc -l",
      "expect": "num:^(\\d+) >=5"
    },
    {
      "name": "no_unsafe",
      "cmd": "grep -rn 'unsafe' rust/dp-air/src | grep -v 'forbid(unsafe_code)' | wc -l",
      "expect": "num:^(\\d+) <=0"
    },
    {
      "name": "purity",
      "cmd": "bash tools/dp_air_purity.sh | tail -1",
      "expect": "num:нарушений: (\\d+) <=0"
    },
    {
      "name": "step_cost_3041",
      "cmd": "cargo run --release --manifest-path rust/Cargo.toml -p dp-air --example step_cost",
      "expect": "num:ms_per_game_s_3041=([0-9.]+) <=45"
    },
    {
      "name": "cargo_test",
      "cmd": "cargo test --manifest-path rust/Cargo.toml --workspace",
      "expect": "exit=0"
    },
    {
      "name": "clippy",
      "cmd": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
      "expect": "exit=0"
    },
    {
      "name": "fmt",
      "cmd": "cargo fmt --manifest-path rust/Cargo.toml --all --check",
      "expect": "exit=0"
    },
    {
      "name": "report_doc",
      "cmd": "test -s docs/research/rust-wind-stage3/rw19-perf.md",
      "expect": "exit=0"
    },
    {
      "name": "docs_check",
      "cmd": ".dpcli/dpcli docs check",
      "expect": "re:ошибок 0"
    },
    {
      "name": "build_windows_release",
      "cmd": "tools/build_rust.sh release windows && test -s addons/dp_air/bin/dp_air_release.dll",
      "expect": "exit=0"
    }
  ],
