  "accept": [
    {
      "name": "changelog",
      "cmd": "sed -n '/^## В работе/,/^## [0-9]/p' CHANGELOG.md | grep -ciE 'ветер|погод|загрузк'",
      "expect": "num:^(\\d+) >=3"
    },
    {
      "name": "findings",
      "cmd": "grep -rc 'rust-wind' docs/registry/ | awk -F: '{s+=$2} END {print s}'",
      "expect": "num:^(\\d+) >=6"
    },
    {
      "name": "docs_check",
      "cmd": ".dpcli/dpcli docs check",
