  "goal": "Случаи PT1 (R1 + pt) для Askervein и Каянчи на 50/100 м и Perdigão NE/SW на 30 м, растры 30 м, выборка PT5; база picard_rs 1-го порядка и эталон air3d 12,5–25 м 2-го порядка — строки PT4 и таблица разгона как в primer §8.2.",
  "plan_ref": "Задачи 1",
  "contracts": [
    {
      "name": "PT1",
      "version": "1",
      "ref": "docs/contracts/picard-terrain.md"
    },
    {
      "name": "PT4",
      "version": "1",
      "ref": "docs/contracts/picard-terrain.md"
    },
    {
      "name": "PT5",
      "version": "1",
      "ref": "docs/contracts/picard-terrain.md"
    }
  ],
  "copy": "~/worktrees/deltaplan/picard-terrain-PT-1",
  "branch": "picard-terrain/PT-1",
  "base": "feature/picard-terrain",
  "scope": [
    "tools/research/picard_terrain/make_cases.py",
    "tools/research/picard_terrain/sample.py",
    "tools/research/picard_terrain/air3d_state.py",
    "tools/research/picard_terrain/run_base.py",
    "tools/research/picard_terrain/out/PT-1",
    "tools/research/picard_terrain/README.md"
  ],
  "dont_touch": [
    "rust",
    "tools/research/air3d",
