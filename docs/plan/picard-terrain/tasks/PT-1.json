    "tools/research/sw_charges_3d",
    "tools/research/picard_terrain/contract",
    "scripts",
    "project.godot",
    "docs/contracts"
  ],
  "accept": [
    {
      "name": "contract-cases",
      "cmd": "python3 tools/research/picard_terrain/contract/check_contract.py cases $HOME/data/picard_terrain/cases/askervein_d50.json $HOME/data/picard_terrain/cases/askervein_d100.json $HOME/data/picard_terrain/cases/kayancha_d50.json $HOME/data/picard_terrain/cases/kayancha_d100.json $HOME/data/picard_terrain/cases/perdigao_ne_d30.json $HOME/data/picard_terrain/cases/perdigao_sw_d30.json",
      "expect": "exit=0"
    },
    {
      "name": "contract-rows",
      "cmd": "python3 tools/research/picard_terrain/contract/check_contract.py rows tools/research/picard_terrain/out/PT-1/rows.jsonl",
      "expect": "exit=0"
    },
    {
      "name": "refs",
      "cmd": "python3 -c \"import json;r=[json.loads(l) for l in open('tools/research/picard_terrain/out/PT-1/rows.jsonl') if l.strip()];print('refs=%d'%len({x['case'] for x in r if x['solver']=='air3d' and x['adv2'] and x['dx']<=25}))\"",
      "expect": "num:refs=(\\d+) >=3"
    },
    {
      "name": "base-ok",
      "cmd": "python3 -c \"import json;r=[json.loads(l) for l in open('tools/research/picard_terrain/out/PT-1/rows.jsonl') if l.strip()];print('base_ok=%d'%len({x['case'] for x in r if x['solver']=='picard_rs' and not x['cut_cells'] and not x['adv2'] and x['status']=='ok'}))\"",
      "expect": "num:base_ok=(\\d+) >=6"
    }
  ],
