# Копия -> /etc/default/deltaplan-server (владелец root, права 640 достаточно).
# Адрес и порт, на которых слушает сервер.
DELTAPLAN_ADDR=:8080

# Версия игры, с которой сверяется Hello от клиента (VERSION_MISMATCH при несовпадении).
# Необязательно: если пусто/не задано — сервер версию не проверяет.
#DELTAPLAN_GAME_VERSION=1.0.0
