[Unit]
Description=Deltaplan multiplayer relay server
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/deltaplan-server
EnvironmentFile=-/etc/default/deltaplan-server
Restart=always
RestartSec=2s

# Логи идут в stdout/stderr -> journald (journalctl -u deltaplan-server -f).
StandardOutput=journal
StandardError=journal

# Усиление песочницы: без DynamicUser отдельный системный пользователь не нужен.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
