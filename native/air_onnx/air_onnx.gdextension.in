; GDExtension AirOnnx (контракт O2). Шаблон: native/air_onnx/build.sh копирует его в
; addons/air_onnx/air_onnx.gdextension после сборки (не в git). Есть файл — Godot регистрирует
; расширение (импорт редактора) и при экспорте кладёт библиотеку и зависимости рядом с исполняемым файлом.
[configuration]
entry_symbol = "air_onnx_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.x86_64 = "bin/linux/libair_onnx.so"
windows.x86_64 = "bin/windows/air_onnx.dll"

[dependencies]
; "" — в экспорте рядом с исполняемым файлом (там же, где библиотека расширения: ORT ищется в её каталоге).
linux.x86_64 = { "bin/linux/libonnxruntime.so.1": "" }
windows.x86_64 = { "bin/windows/onnxruntime.dll": "", "bin/windows/msvcp140.dll": "", "bin/windows/msvcp140_1.dll": "", "bin/windows/vcruntime140.dll": "", "bin/windows/vcruntime140_1.dll": "" }
