; Пробник NN-7а (не финальный N5). Копируется build.sh в bin/; грузится тестом через
; GDExtensionManager.load_extension(), а не автоматически (bin/ скрыт .gdignore).
[configuration]
entry_symbol = "air_nn_probe_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.x86_64 = "linux/libair_nn_probe.so"
windows.x86_64 = "windows/air_nn_probe.dll"

[dependencies]
linux.x86_64 = { "linux/libonnxruntime.so.1": "" }
windows.x86_64 = { "windows/onnxruntime.dll": "" }
