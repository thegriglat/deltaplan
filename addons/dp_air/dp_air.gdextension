[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
; редакторный и тестовый бинарь Godot берёт ключ debug -> сборка tune; экспорт release -> release
linux.debug.x86_64 = "res://addons/dp_air/bin/libdp_air_tune.so"
linux.release.x86_64 = "res://addons/dp_air/bin/libdp_air_release.so"
windows.debug.x86_64 = "res://addons/dp_air/bin/dp_air_tune.dll"
windows.release.x86_64 = "res://addons/dp_air/bin/dp_air_release.dll"
