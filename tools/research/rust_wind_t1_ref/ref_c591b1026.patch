@@ -228,3 +233,27 @@ func _make_atmosphere(
 	atmo.set_focus(sp)
 	atmo.step(0.01)
 	return atmo
+
+
+## Статус решателя по уровням в meta.solver (W8 v2): {heat: {stop, iters, div_rms}, mech: {...}}.
+## Результаты Пикара: порядок «без нагрева, с нагревом» (results[0] — mech, results[1] — heat).
+## Область — из последнего расчёта AirRuntime (последний проход загрузки), окна — из последней
+## записи clipmap.history того же dx. Нет записи — ключ не пишется.
+func _attach_solver(rt: AirRuntime, fs: AirFieldSet) -> void:
+	var by_dx := {}
+	if rt._clip != null:
+		for h: Dictionary in rt._clip.history:
+			by_dx[roundi(float(h.dx))] = h.get("solver", [])
+	var dom: Array = rt.last_info.get("solver", [])
+	for f: WindField in fs.levels:
+		var res: Array = by_dx.get(roundi(f.dx), []) if f.meta.get("level", "") == "window" else dom
+		if res.size() < 2:
+			print("bake_air: dx%d — статуса решателя нет" % roundi(f.dx))
+			continue
+		f.meta["solver"] = {mech = _stop_of(res[0]), heat = _stop_of(res[1])}
+		print("bake_air: dx%d solver %s" % [roundi(f.dx), JSON.stringify(f.meta["solver"])])
+
+
+static func _stop_of(r: Dictionary) -> Dictionary:
+	var st := {ok = "converged", max = "max_iters", diverged = "diverged"}
+	return {stop = st.get(String(r.status), String(r.status)), iters = int(r.iters), div_rms = float(r.div_rms)}
diff --git a/tools/terrain/cpu_phase_job.gd b/tools/terrain/cpu_phase_job.gd
new file mode 100644
index 000000000..1ec31a1a7
--- /dev/null
+++ b/tools/terrain/cpu_phase_job.gd
@@ -0,0 +1,12 @@
+extends RefCounted
+## Фазы поля на CPU (f64, AirPhaseCpu) для AirRuntime.phase_factory: только run(case) — runtime
+## ведёт его в рабочем потоке (нет start/poll). RW-6u.
+
+var case: AirCase
+var error := ""
+
+
+func run(c: AirCase) -> Dictionary:
+	var r := AirPhaseCpu.run(c, AirPhase.config())
+	error = String(r.get("error", ""))
+	return r
