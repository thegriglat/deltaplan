#!/usr/bin/env python3
"""dp — журнал, карточки задач и приёмка модулей Deltaplan (только стандартная библиотека).

Хранение: docs/plan/<модуль>/ — module.json, tasks/<ID>.json (карточка), tasks/<ID>.report.json
(отчёт исполнителя), tasks/<ID>.review.json (ревью), events.jsonl и decisions.jsonl (только дописывание). Дом журнала модуля —
рабочая копия ветки feature/<модуль>, если она есть (видно из любой копии), иначе текущая копия.
Справка с примерами — tools/dp.md. Коды выхода: 0 ок, 1 ошибка/проверка не прошла, 2 аргументы.
"""
import argparse
import concurrent.futures as cf
import datetime as dt
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

LIFECYCLE = ["created", "started", "reported", "checked", "reviewed", "accepted", "merged", "blocked", "cancelled"]
EVENT_KINDS = ["started", "reported", "accepted", "merged", "blocked", "cancelled", "note"]
FINAL = {"accepted", "merged", "cancelled"}
REPORT_STATUS = {"done", "partial", "blocked", "failed"}
REVIEW_TYPES = {"dp-engineer", "dp-researcher"}  # этим задачам после PASS нужен dp-reviewer
VERDICTS = ("accept", "rework")
SEVERITY = {"blocker": "B", "major": "M", "minor": "m"}
MAX_ISSUES = 7
GODOT_TESTS = "godot --headless --path . res://tests/run_tests.tscn -- --filter={f}"


class DpError(Exception):
    pass


def die(msg, code=1):
    print(f"dp: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return dt.datetime.now().replace(microsecond=0).isoformat()


def git(*args, cwd=None, check=False):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        raise DpError(f"git {' '.join(args)}: {r.stderr.strip().splitlines()[-1:]}")
    return r.stdout.strip() if r.returncode == 0 else ""


_TOP = None


def toplevel():
    global _TOP
    if _TOP is None:
        t = git("rev-parse", "--show-toplevel")
        if not t:
            raise DpError("не в рабочей копии git")
        _TOP = Path(t)
    return _TOP


_WT = None


def worktrees():
    """[(path, branch)] из git worktree list --porcelain."""
    global _WT
    if _WT is None:
        _WT, path = [], None
        for line in git("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree "):
                path = line[9:]
            elif line.startswith("branch "):
                _WT.append((path, line[7:].removeprefix("refs/heads/")))
            elif line == "detached" and path:
                _WT.append((path, "(detached)"))
    return _WT


def module_home(mod):
    """Каталог журнала модуля: копия feature/<mod>, если есть, иначе текущая."""
    if not os.environ.get("DP_LOCAL"):
        for path, br in worktrees():
            if br == f"feature/{mod}" and is_module_dir(Path(path) / "docs/plan" / mod):
                return Path(path) / "docs/plan" / mod
    return toplevel() / "docs/plan" / mod


def is_module_dir(d):
    return (d / "events.jsonl").exists() or (d / "module.json").exists()


def all_modules():
    found = {}
    roots = [toplevel()] + ([] if os.environ.get("DP_LOCAL") else [Path(p) for p, b in worktrees() if b.startswith("feature/")])
    for root in roots:
        base = root / "docs/plan"
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if d.is_dir() and is_module_dir(d) and d.name not in found:
                    found[d.name] = module_home(d.name)
    return found


def find_task(tid):
    """(модуль, каталог модуля) по ID задачи."""
    mods = all_modules()
    hits = [(m, h) for m, h in mods.items() if (h / "tasks" / f"{tid}.json").exists()]
    if not hits:
        raise DpError(f"задача {tid} не найдена (модули: {', '.join(mods) or 'нет'})")
    if len(hits) > 1:
        raise DpError(f"{tid} есть в нескольких модулях: {', '.join(m for m, _ in hits)}")
    return hits[0]


def read_json(p):
    try:
        return json.loads(Path(p).read_text())
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        raise DpError(f"{p}: неверный JSON ({e})")


def write_json(p, obj):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n")


def append_jsonl(p, obj):
    p.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(obj, ensure_ascii=False) + "\n"
    fd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line.encode())
    finally:
        os.close(fd)


def read_jsonl(p):
    out = []
    try:
        for i, line in enumerate(Path(p).read_text().splitlines(), 1):
            if line.strip():
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    print(f"dp: {p}:{i}: пропущена неверная строка", file=sys.stderr)
    except FileNotFoundError:
        pass
    return out


def by_default(args):
    return getattr(args, "by", None) or os.environ.get("DP_ROLE") or "-"


def rel(p):
    try:
        return str(Path(p).relative_to(toplevel()))
    except ValueError:
        return str(p).replace(str(Path.home()), "~")


def age(ts):
    try:
        s = (dt.datetime.now() - dt.datetime.fromisoformat(ts)).total_seconds()
    except (TypeError, ValueError):
        return "?"
    if s < 3600:
        return f"{int(s // 60)}м"
    if s < 86400:
        return f"{int(s // 3600)}ч"
    return f"{int(s // 86400)}д"


def short(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


# ---------------------------------------------------------------- модуль, события

def module_meta(mod, home):
    m = read_json(home / "module.json") or {}
    m.setdefault("module", mod)
    m.setdefault("plan", f"docs/plan/{mod}.md")
    m.setdefault("contracts", f"docs/{mod}_contracts.md")
    m.setdefault("branch", f"feature/{mod}")
    return m


def ensure_module(mod, home, **kw):
    p = home / "module.json"
    if not p.exists():
        meta = {"module": mod, "plan": f"docs/plan/{mod}.md", "contracts": f"docs/{mod}_contracts.md",
                "branch": f"feature/{mod}", "copy": f"~/deltaplan-{mod}", "created": now()}
        meta.update({k: v for k, v in kw.items() if v})
        write_json(p, meta)
    (home / "tasks").mkdir(parents=True, exist_ok=True)
    (home / "events.jsonl").touch()


def add_event(home, task, kind, by, note="", commits=None, **extra):
    ev = {"t": now(), "by": by, "task": task, "ev": kind}
    if commits:
        ev["commits"] = commits
    if note:
        ev["note"] = note
    ev.update({k: v for k, v in extra.items() if v not in (None, "", [], {})})
    append_jsonl(home / "events.jsonl", ev)
    return ev


def rev_tag(ev):
    """rev:rework 2B1M — вердикт и число замечаний по серьёзности."""
    cnt = ev.get("issues") or {}
    return f"rev:{ev.get('verdict', '?')}" + ("" if not any(cnt.values()) else " " + "".join(
        f"{cnt[k]}{SEVERITY[k]}" for k in SEVERITY if cnt.get(k)))


def task_cards(home):
    return {p.stem: read_json(p) for p in sorted((home / "tasks").glob("*.json"))
            if not p.name.endswith((".report.json", ".review.json"))}


def task_states(home):
    """{ID: {status, t, last_t, commits[], note}} по событиям."""
    st = {}
    for ev in read_jsonl(home / "events.jsonl"):
        tid = ev.get("task")
        if not tid:
            continue
        s = st.setdefault(tid, {"status": "created", "t": ev.get("t"), "last_t": ev.get("t"), "commits": [], "note": "", "rev": ""})
        s["last_t"] = ev.get("t")
        k = ev.get("ev")
        if k in LIFECYCLE and not (k == "checked" and s["status"] in FINAL):
            s["status"] = k
            s["t"] = ev.get("t")
            if k in ("blocked", "checked", "accepted", "cancelled"):
                s["note"] = ev.get("note", "")
        if k == "reviewed":
            s["rev"] = rev_tag(ev)
        for c in ev.get("commits", []):
            if c not in s["commits"]:
                s["commits"].append(c)
    return st


# ---------------------------------------------------------------- task

CARD_TEMPLATE = {
    "id": "", "module": "", "type": "", "title": "", "goal": "",
    "plan_ref": "", "contracts": [], "copy": "", "branch": "", "base": "",
    "scope": [], "dont_touch": [], "accept": [], "report_extra": [], "notes": "",
}


def cmd_task_new(a):
    home = module_home(a.module)
    p = home / "tasks" / f"{a.id}.json"
    if p.exists() and not a.force:
        raise DpError(f"карточка уже есть: {rel(p)} (--force — перезаписать)")
    card = dict(CARD_TEMPLATE)
    if a.from_:
        src = sys.stdin.read() if a.from_ == "-" else Path(a.from_).read_text()
        try:
            card.update(json.loads(src))
        except json.JSONDecodeError as e:
            raise DpError(f"--from: неверный JSON ({e})")
    meta = module_meta(a.module, home)
    card.update({"id": a.id, "module": a.module})
    for k in ("type", "title", "goal", "plan_ref", "copy", "branch"):
        v = getattr(a, k, None)
        if v:
            card[k] = v
    card["branch"] = card["branch"] or f"{a.module}/{a.id}"
    card["copy"] = card["copy"] or f"~/deltaplan-{a.module}-{a.id}"
    card["base"] = card["base"] or meta["branch"]
    for c in a.contract or []:
        name, _, ver = c.partition("@")
        card["contracts"].append({"name": name, "version": ver or "?", "ref": meta["contracts"]})
    card["scope"] += a.scope or []
    card["dont_touch"] += a.dont_touch or []
    for f in a.test or []:
        card["accept"].append({"name": f, "tests": f})
    for name, cmd, exp in a.check or []:
        card["accept"].append({"name": name, "cmd": cmd, "expect": exp})
    if not card["type"]:
        raise DpError("нужен --type (dp-engineer|dp-researcher|dp-writer|dp-mechanic)")
    ensure_module(a.module, home)
    card["created"] = card.get("created") or now()
    write_json(p, card)
    add_event(home, a.id, "created", by_default(a), note=card.get("title", ""))
    empty = [k for k in ("goal", "scope", "accept") if not card.get(k)]
    print(f"{a.id}: {rel(p)}" + (f"; пусто: {', '.join(empty)}" if empty else ""))


def fmt_check(c):
    if c.get("tests"):
        return f"{c['name']}: тесты --filter={c['tests']} → 0 упало"
    exp = c.get("expect", "exit=0")
    return f"{c['name']}: `{c.get('cmd', '')}` → {json.dumps(exp, ensure_ascii=False) if isinstance(exp, dict) else exp}"


def cmd_task_show(a):
    mod, home = find_task(a.id)
    card = read_json(home / "tasks" / f"{a.id}.json")
    if a.json:
        print(json.dumps(card, ensure_ascii=False, indent=2))
        return
    meta = module_meta(mod, home)
    L = [f"{card['id']} [{mod}] {card.get('title', '')} — {card.get('type', '')}"]
    if card.get("goal"):
        L.append(f"Цель: {card['goal']}")
    plan = meta["plan"] + (f" {card['plan_ref']}" if card.get("plan_ref") else "")
    L.append(f"План: {plan} (dp plan {mod} <раздел>)")
    L.append(f"Копия: {card.get('copy')}  ветка: {card.get('branch')} от {card.get('base')}")
    if card.get("contracts"):
        L.append("Контракты: " + "; ".join(f"{c['name']} v{c.get('version', '?')} ({c.get('ref', '')})" for c in card["contracts"]))
    if card.get("scope"):
        L.append("Скоуп: " + ", ".join(card["scope"]))
    if card.get("dont_touch"):
        L.append("Не трогать: " + ", ".join(card["dont_touch"]))
    if card.get("accept"):
        L.append("Приёмка (dp accept " + card["id"] + "):")
        L += [f"  - {fmt_check(c)}" for c in card["accept"]]
    if card.get("notes"):
        L.append(f"Заметки: {card['notes']}")
    L.append("Правила: /home/greg/deltaplan/.claude/workflow.md, «Общие правила».")
    rx = ", ".join(card.get("report_extra") or [])
    L.append(f"Отчёт: dp report {card['id']} < отчёт.json (dp report --template){'; ещё поля: ' + rx if rx else ''}; "
             f"в конце — обратная связь по dp (поле dp_feedback).")
    print("\n".join(L))


# ---------------------------------------------------------------- event / decide / log

def resolve_target(x):
    """ID задачи или имя модуля → (модуль, дом, task|None)."""
    mods = all_modules()
    if x in mods:
        return x, mods[x], None
    mod, home = find_task(x)
    return mod, home, x


def cmd_event(a):
    mod, home, task = resolve_target(a.target)
    if task is None and a.kind != "note":
        raise DpError("для модуля — только note; для задачи — ID")
    add_event(home, task, a.kind, by_default(a), note=a.note or "", commits=a.commit)
    print(f"{task or mod}: {a.kind}")


def cmd_decide(a):
    mods = all_modules()
    home = mods.get(a.module) or module_home(a.module)
    ensure_module(a.module, home)
    decs = read_jsonl(home / "decisions.jsonl")
    d = {"t": a.date or now(), "by": a.by or by_default(a), "text": a.text}
    if a.why:
        d["why"] = a.why
    if a.task:
        d["task"] = a.task
    if a.ask:
        n = 1 + sum(1 for x in decs if x.get("kind") == "question")
        d.update({"kind": "question", "id": f"Q{n}"})
    else:
        d["kind"] = "decision"
        if a.answers:
            d["answers"] = a.answers
    append_jsonl(home / "decisions.jsonl", d)
    print(f"{a.module}: {d.get('id', 'решение')} записан{'' if a.ask else 'о'} ({d['by']})")


def cmd_log(a):
    mod, home, task = resolve_target(a.target)
    evs = [e for e in read_jsonl(home / "events.jsonl") if task is None or e.get("task") == task]
    for e in evs[-a.n:]:
        c = (" " + ",".join(e["commits"])) if e.get("commits") else ""
        n = (" — " + short(e["note"], 100 if not a.full else 10000)) if e.get("note") else ""
        print(f"{e['t'][5:16].replace('T', ' ')} {e.get('task') or '·'} {e['ev']} ({e.get('by', '-')}){c}{n}")


