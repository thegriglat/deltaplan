#!/usr/bin/env python3
"""dp — журнал, карточки задач и приёмка модулей Deltaplan (только стандартная библиотека).

Хранение: docs/plan/<модуль>/ — module.json, tasks/<ID>.json (карточка), tasks/<ID>.report.json
(отчёт исполнителя), tasks/<ID>.review.json (ревью), events.jsonl и decisions.jsonl (только дописывание). Дом журнала модуля —
рабочая копия ветки feature/<модуль>, если она есть (видно из любой копии), иначе текущая копия.
Справка с примерами — tools/dp.md. Коды выхода: 0 ок, 1 ошибка/проверка не прошла, 2 аргументы.
"""
import argparse
import concurrent.futures as cf
import datetime as dt
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

DP_VERSION = 3  # поднимать при каждом изменении: старые копии перезапускаются из главной (maybe_reexec)
MAIN_DP = os.environ.get("DP_MAIN_COPY") or "/home/greg/deltaplan/tools/dp"

LIFECYCLE = ["created", "started", "reported", "checked", "reviewed", "accepted", "merged", "blocked", "cancelled"]
EVENT_KINDS = ["started", "reported", "accepted", "merged", "blocked", "cancelled", "note"]
FINAL = {"accepted", "merged", "cancelled"}
REPORT_STATUS = {"done", "partial", "blocked", "failed"}
REVIEW_TYPES = {"dp-engineer", "dp-researcher"}  # этим задачам после PASS нужен dp-reviewer
VERDICTS = ("accept", "rework")
SEVERITY = {"blocker": "B", "major": "M", "minor": "m"}
MAX_ISSUES = 7
DEFAULT_SECTION = "Решения пользователя"
CODE_RE = re.compile(r"^[A-Z]{2,4}$")
ID_RE = re.compile(r"^([A-Z]{2,4})-(\d+)[a-z]?$")
RESERVED_CODES = {"T"}  # T-<n> — реестр TODO.md (всё равно короче 2 букв, но держим явно)
GODOT_TESTS = "godot --headless --path . res://tests/run_tests.tscn -- --filter={f}"


class DpError(Exception):
    pass


def maybe_reexec():
    """Если в главной копии dp новее (DP_VERSION) — перезапуститься из неё (те же аргументы, тот же cwd)."""
    if os.environ.get("DP_NO_REEXEC") or os.environ.get("DP_REEXECED"):
        return
    try:
        main = Path(MAIN_DP)
        if not main.is_file() or main.resolve() == Path(__file__).resolve():
            return
        m = re.search(r"^DP_VERSION\s*=\s*(\d+)", main.read_text()[:6000], re.M)
        if not m or int(m[1]) <= DP_VERSION:
            return
        print(f"dp: версия {DP_VERSION} старее главной ({m[1]}) — запуск из {MAIN_DP} (DP_NO_REEXEC=1 — отключить)", file=sys.stderr)
        os.environ["DP_REEXECED"] = "1"
        os.execv(sys.executable, [sys.executable, str(main)] + sys.argv[1:])
    except OSError:
        return


def die(msg, code=1):
    print(f"dp: {msg}", file=sys.stderr)
    sys.exit(code)


def now():
    return dt.datetime.now().replace(microsecond=0).isoformat()


def git(*args, cwd=None, check=False):
    r = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and r.returncode:
        raise DpError(f"git {' '.join(args)}: {r.stderr.strip().splitlines()[-1:]}")
    return r.stdout.strip() if r.returncode == 0 else ""


_TOP = None


def toplevel():
    global _TOP
    if _TOP is None:
        t = git("rev-parse", "--show-toplevel")
        if not t:
            raise DpError("не в рабочей копии git")
        _TOP = Path(t)
    return _TOP


_WT = None


def worktrees():
    """[(path, branch)] из git worktree list --porcelain."""
    global _WT
    if _WT is None:
        _WT, path = [], None
        for line in git("worktree", "list", "--porcelain").splitlines():
            if line.startswith("worktree "):
                path = line[9:]
            elif line.startswith("branch "):
                _WT.append((path, line[7:].removeprefix("refs/heads/")))
            elif line == "detached" and path:
                _WT.append((path, "(detached)"))
    return _WT


def module_home(mod):
    """Каталог журнала модуля: копия feature/<mod>, если есть, иначе текущая."""
    if not os.environ.get("DP_LOCAL"):
        for path, br in worktrees():
            if br == f"feature/{mod}" and is_module_dir(Path(path) / "docs/plan" / mod):
                return Path(path) / "docs/plan" / mod
    return toplevel() / "docs/plan" / mod


def is_module_dir(d):
    return (d / "events.jsonl").exists() or (d / "module.json").exists()


def all_modules():
    found = {}
    roots = [toplevel()] + ([] if os.environ.get("DP_LOCAL") else [Path(p) for p, b in worktrees() if b.startswith("feature/")])
    for root in roots:
        base = root / "docs/plan"
        if base.is_dir():
            for d in sorted(base.iterdir()):
                if d.is_dir() and is_module_dir(d) and d.name not in found:
                    found[d.name] = module_home(d.name)
    return found


def find_task(tid):
    """(модуль, каталог модуля) по ID задачи."""
    mods = all_modules()
    hits = [(m, h) for m, h in mods.items() if (h / "tasks" / f"{tid}.json").exists()]
    if not hits:
        raise DpError(f"задача {tid} не найдена (модули: {', '.join(mods) or 'нет'})")
    if len(hits) > 1:
        raise DpError(f"{tid} есть в нескольких модулях: {', '.join(m for m, _ in hits)}")
    return hits[0]


def read_json(p):
    try:
        return json.loads(Path(p).read_text())
    except FileNotFoundError:
        return None
    except json.JSONDecodeError as e:
        raise DpError(f"{p}: неверный JSON ({e})")


def write_json(p, obj):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n")


def append_jsonl(p, obj):
    p.parent.mkdir(parents=True, exist_ok=True)
    line = json.dumps(obj, ensure_ascii=False) + "\n"
    fd = os.open(p, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        os.write(fd, line.encode())
    finally:
        os.close(fd)


def read_jsonl(p):
    out = []
    try:
        for i, line in enumerate(Path(p).read_text().splitlines(), 1):
            if line.strip():
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    print(f"dp: {p}:{i}: пропущена неверная строка", file=sys.stderr)
    except FileNotFoundError:
        pass
    return out


def by_default(args):
    return getattr(args, "by", None) or os.environ.get("DP_ROLE") or "-"


def rel(p):
    try:
        return str(Path(p).relative_to(toplevel()))
    except ValueError:
        return str(p).replace(str(Path.home()), "~")


def age(ts):
    try:
        s = (dt.datetime.now() - dt.datetime.fromisoformat(ts)).total_seconds()
    except (TypeError, ValueError):
        return "?"
    if s < 3600:
        return f"{int(s // 60)}м"
    if s < 86400:
        return f"{int(s // 3600)}ч"
    return f"{int(s // 86400)}д"


def short(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


# ---------------------------------------------------------------- модуль, события

def module_meta(mod, home):
    m = read_json(home / "module.json") or {}
    m.setdefault("module", mod)
    m.setdefault("plan", f"docs/plan/{mod}.md")
    m.setdefault("contracts", f"docs/{mod}_contracts.md")
    m.setdefault("branch", f"feature/{mod}")
    return m


def module_codes():
    """{код: модуль} по module.json всех модулей."""
    out = {}
    for m, h in all_modules().items():
        c = (read_json(h / "module.json") or {}).get("code")
        if c:
            out[c] = m
    return out


def check_code(code, mod):
    if not CODE_RE.match(code) or code in RESERVED_CODES:
        raise DpError(f"код модуля «{code}»: 2–4 заглавные латинские буквы (T зарезервирован под TODO.md), напр. NN, UC")
    other = module_codes().get(code)
    if other and other != mod:
        raise DpError(f"код {code} уже у модуля {other}")


def ensure_module(mod, home, **kw):
    if kw.get("code"):
        check_code(kw["code"], mod)
    p = home / "module.json"
    if not p.exists():
        meta = {"module": mod, "plan": f"docs/plan/{mod}.md", "contracts": f"docs/{mod}_contracts.md",
                "branch": f"feature/{mod}", "copy": f"~/deltaplan-{mod}", "created": now()}
        meta.update({k: v for k, v in kw.items() if v})
        write_json(p, meta)
    (home / "tasks").mkdir(parents=True, exist_ok=True)
    (home / "events.jsonl").touch()


def add_event(home, task, kind, by, note="", commits=None, **extra):
    ev = {"t": now(), "by": by, "task": task, "ev": kind}
    if commits:
        ev["commits"] = commits
    if note:
        ev["note"] = note
    ev.update({k: v for k, v in extra.items() if v not in (None, "", [], {})})
    append_jsonl(home / "events.jsonl", ev)
    return ev


def rev_tag(ev):
    """rev:rework 2B1M — вердикт и число замечаний по серьёзности."""
    cnt = ev.get("issues") or {}
    return f"rev:{ev.get('verdict', '?')}" + ("" if not any(cnt.values()) else " " + "".join(
        f"{cnt[k]}{SEVERITY[k]}" for k in SEVERITY if cnt.get(k)))


def task_cards(home):
    return {p.stem: read_json(p) for p in sorted((home / "tasks").glob("*.json"))
            if not p.name.endswith((".report.json", ".review.json"))}


def task_states(home):
    """{ID: {status, t, last_t, commits[], note}} по событиям."""
    st = {}
    for ev in read_jsonl(home / "events.jsonl"):
        tid = ev.get("task")
        if not tid:
            continue
        s = st.setdefault(tid, {"status": "created", "t": ev.get("t"), "last_t": ev.get("t"), "commits": [], "note": "", "rev": "", "seen": set()})
        s["last_t"] = ev.get("t")
        k = ev.get("ev")
        s["seen"].add(k)
        if k in LIFECYCLE and not (k == "checked" and s["status"] in FINAL):
            s["status"] = k
            s["t"] = ev.get("t")
            if k in ("blocked", "checked", "accepted", "cancelled"):
                s["note"] = ev.get("note", "")
        if k == "reviewed":
            s["rev"] = rev_tag(ev)
        for c in ev.get("commits", []):
            if c not in s["commits"]:
                s["commits"].append(c)
    return st


# ---------------------------------------------------------------- task

CARD_TEMPLATE = {
    "id": "", "module": "", "type": "", "title": "", "goal": "",
    "plan_ref": "", "contracts": [], "copy": "", "branch": "", "base": "",
    "scope": [], "dont_touch": [], "accept": [], "report_extra": [], "notes": "",
}


def cmd_task_new(a):
    home = module_home(a.module)
    if not a.id:
        code = (read_json(home / "module.json") or {}).get("code")
        if not code:
            raise DpError(f"у модуля {a.module} нет кода: dp init {a.module} --code XX (2–4 заглавные буквы), либо задайте ID явно")
        nums = [int(m[2]) for t in task_cards(home) if (m := ID_RE.match(t)) and m[1] == code]
        a.id = f"{code}-{max(nums, default=0) + 1}"
    else:
        if not ID_RE.match(a.id) or a.id.startswith("T-"):
            raise DpError(f"ID «{a.id}»: формат <КОД>-<n>[буква], напр. NN-7 или NN-7a (код — 2–4 заглавные латинские; T — TODO.md); без ID — следующий номер")
        for m, h in all_modules().items():
            if m != a.module and (h / "tasks" / f"{a.id}.json").exists():
                raise DpError(f"ID {a.id} уже есть в модуле {m}")
    p = home / "tasks" / f"{a.id}.json"
    if p.exists() and not a.force:
        raise DpError(f"карточка уже есть: {rel(p)} (--force — перезаписать)")
    card = dict(CARD_TEMPLATE)
    if a.from_:
        src = sys.stdin.read() if a.from_ == "-" else Path(a.from_).read_text()
        try:
            card.update(json.loads(src))
        except json.JSONDecodeError as e:
            raise DpError(f"--from: неверный JSON ({e})")
    meta = module_meta(a.module, home)
    card.update({"id": a.id, "module": a.module})
    for k in ("type", "title", "goal", "plan_ref", "copy", "branch"):
        v = getattr(a, k, None)
        if v:
            card[k] = v
    card["branch"] = card["branch"] or f"{a.module}/{a.id}"
    card["copy"] = card["copy"] or f"~/deltaplan-{a.module}-{a.id}"
    card["base"] = card["base"] or meta["branch"]
    for c in a.contract or []:
        name, _, ver = c.partition("@")
        card["contracts"].append({"name": name, "version": ver or "?", "ref": meta["contracts"]})
    card["scope"] += a.scope or []
    card["dont_touch"] += a.dont_touch or []
    for f in a.test or []:
        card["accept"].append({"name": f, "tests": f})
    for name, cmd, exp in a.check or []:
        card["accept"].append({"name": name, "cmd": cmd, "expect": expect_arg(exp)})
    if not card["type"]:
        raise DpError("нужен --type (dp-engineer|dp-researcher|dp-writer|dp-mechanic)")
    ensure_module(a.module, home)
    card["created"] = card.get("created") or now()
    write_json(p, card)
    add_event(home, a.id, "created", by_default(a), note=card.get("title", ""))
    empty = [k for k in ("goal", "scope", "accept") if not card.get(k)]
    print(f"{a.id}: {rel(p)}" + (f"; пусто: {', '.join(empty)}" if empty else ""))


def expect_arg(exp):
    """EXPECT из командной строки: «{…}» — JSON-объект (составное условие), иначе строка."""
    if isinstance(exp, str) and exp.lstrip().startswith("{"):
        try:
            return json.loads(exp)
        except json.JSONDecodeError as e:
            raise DpError(f"expect: неверный JSON-объект ({e})")
    return exp


def fmt_check(c):
    if c.get("tests"):
        return f"{c['name']}: тесты --filter={c['tests']} → 0 упало"
    exp = c.get("expect", "exit=0")
    return f"{c['name']}: `{c.get('cmd', '')}` → {json.dumps(exp, ensure_ascii=False) if isinstance(exp, dict) else exp}"


def _set_value(raw):
    """Значение поля: JSON, если разбирается (числа, списки, объекты, true/false), иначе строка."""
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


def cmd_task_set(a):
    """Правка карточки без переписывания JSON: поле=значение, поле+=элемент, поле-=элемент, проверки приёмки."""
    mod, home = find_task(a.id)
    p = home / "tasks" / f"{a.id}.json"
    card = read_json(p)
    before = json.loads(json.dumps(card))
    changed = []
    for op in a.ops or []:
        m = re.match(r"^([A-Za-z_][\w]*)(\+=|-=|=)(.*)$", op, re.S)
        if not m:
            raise DpError(f"«{op}»: ожидалось поле=значение | поле+=элемент | поле-=элемент")
        key, kind, raw = m.groups()
        if key == "id":
            raise DpError("id не меняется")
        val = _set_value(raw)
        if kind == "=":
            card[key] = val
        else:
            lst = card.get(key)
            if lst is None:
                lst = []
            if not isinstance(lst, list):
                raise DpError(f"{key} — не список, «{kind}» неприменимо")
            if kind == "+=":
                lst.append(val)
            else:
                keep = [x for x in lst if not (x == val or (isinstance(x, dict) and x.get("name") == val))]
                if len(keep) == len(lst):
                    raise DpError(f"{key}: «{raw}» не найдено")
                lst = keep
            card[key] = lst
        changed.append(key)
    acc = card.setdefault("accept", [])
    for name, cmd, exp in a.check or []:
        acc[:] = [c for c in acc if c.get("name") != name] + [{"name": name, "cmd": cmd, "expect": expect_arg(exp)}]
        changed.append(f"accept:{name}")
    for f in a.test or []:
        acc[:] = [c for c in acc if c.get("name") != f] + [{"name": f, "tests": f}]
        changed.append(f"accept:{f}")
    for name in a.drop_check or []:
        n0 = len(acc)
        acc[:] = [c for c in acc if c.get("name") != name]
        if len(acc) == n0:
            raise DpError(f"проверки «{name}» нет в карточке")
        changed.append(f"accept:-{name}")
    if not changed:
        raise DpError("нечего менять: поле=значение, --check, --test, --drop-check")
    card["edited"] = now()
    write_json(p, card)
    diff = {k: [short(json.dumps(before.get(k), ensure_ascii=False), 300), short(json.dumps(card.get(k), ensure_ascii=False), 300)]
            for k in dict.fromkeys(c.split(":")[0] for c in changed)}
    add_event(home, a.id, "edited", by_default(a), note=", ".join(changed), diff=diff)
    print(f"{a.id}: изменено — {', '.join(changed)}")


def cmd_task_show(a):
    mod, home = find_task(a.id)
    card = read_json(home / "tasks" / f"{a.id}.json")
    if a.json:
        print(json.dumps(card, ensure_ascii=False, indent=2))
        return
    if a.diff:
        evs = [e for e in read_jsonl(home / "events.jsonl") if e.get("task") == a.id and e.get("ev") == "edited"]
        if not evs:
            print(f"{a.id}: карточка не менялась после создания")
        for e in evs:
            print(f"{hm(e['t'])} ({e.get('by', '-')}) {e.get('note', '')}")
            for k, (old, new) in (e.get("diff") or {}).items():
                print(f"    {k}: {old} → {new}")
        return
    meta = module_meta(mod, home)
    full = a.full
    L = [f"{card['id']} [{mod}] {card.get('title', '')} — {card.get('type', '')}"]
    if card.get("goal"):
        L.append(f"Цель: {card['goal']}")
    plan = meta["plan"] + (f" {card['plan_ref']}" if card.get("plan_ref") else "")
    L.append(f"План: {plan} (dp plan {mod} <раздел>)")
    L.append(f"Копия: {card.get('copy')}  ветка: {card.get('branch')} от {card.get('base')}")
    if card.get("contracts"):
        L.append("Контракты: " + "; ".join(f"{c['name']} v{c.get('version', '?')} ({c.get('ref', '')})" for c in card["contracts"]))
    for key, title in (("scope", "Скоуп"), ("dont_touch", "Не трогать")):
        items = card.get(key) or []
        if items and (full or len(items) > 3):
            L += [f"{title}:"] + [f"  - {x}" for x in items]
        elif items:
            L.append(f"{title}: " + "; ".join(items))
    if card.get("accept"):
        L.append("Приёмка (dp accept " + card["id"] + "; пробный прогон до отчёта — dp accept " + card["id"] + " --dry):")
        L += [f"  - {fmt_check(c)}" for c in card["accept"]]
    if card.get("notes"):
        L.append(f"Заметки: {card['notes']}")
    L.append("Правила: /home/greg/deltaplan/.claude/workflow.md, «Общие правила» (читать обязательно).")
    rx = ", ".join(card.get("report_extra") or [])
    L.append(f"Отчёт: dp report {card['id']} < отчёт.json (dp report --template){'; ещё поля: ' + rx if rx else ''}; "
             f"в конце — обратная связь по dp (поле dp_feedback).")
    if full:
        L.append("Копия задачи — своя; чужие не трогать; контракты менять только через координатора; коммиты — только свои файлы "
                 "(git commit -- <пути>), по-русски, со строкой Claude-Session. Свежая работа соседей — git merge ветки модуля в свою "
                 f"(dp task sync {card['id']}).")
        L.append(f"Журнал и карточка: docs/plan/{mod}/ (dp log {card['id']}, dp task show {card['id']} --diff).")
    print("\n".join(L))


# ---------------------------------------------------------------- event / decide / log

def resolve_target(x):
    """ID задачи или имя модуля → (модуль, дом, task|None)."""
    mods = all_modules()
    if x in mods:
        return x, mods[x], None
    mod, home = find_task(x)
    return mod, home, x


def cmd_event(a):
    mod, home, task = resolve_target(a.target)
    if task is None and a.kind != "note":
        raise DpError("для модуля — только note; для задачи — ID")
    add_event(home, task, a.kind, by_default(a), note=a.note or "", commits=a.commit)
    print(f"{task or mod}: {a.kind}")


def cmd_decide(a):
    mods = all_modules()
    home = mods.get(a.module) or module_home(a.module)
    ensure_module(a.module, home)
    decs = read_jsonl(home / "decisions.jsonl")
    d = {"t": a.date or now(), "by": a.by or by_default(a), "text": a.text}
    plan_note = ""
    if a.plan is not None:
        if a.ask:
            raise DpError("--plan — для решений, не для --ask")
        line = f"- **{a.text}** ({d['t'][:10]})" + (f" — {a.why}" if a.why else "")
        _, title, _ = plan_edit(a.module, a.plan, append=line, create=a.plan == DEFAULT_SECTION)
        plan_note = f"; в план: {short(title, 40)}"
    if a.why:
        d["why"] = a.why
    if a.task:
        d["task"] = a.task
    if a.ask:
        n = 1 + sum(1 for x in decs if x.get("kind") == "question")
        d.update({"kind": "question", "id": f"Q{n}"})
    else:
        d["kind"] = "decision"
        if a.answers:
            d["answers"] = a.answers
    append_jsonl(home / "decisions.jsonl", d)
    print(f"{a.module}: {d.get('id', 'решение')} записан{'' if a.ask else 'о'} ({d['by']}){plan_note}")


def mark(e):
