def pretty(p):
    return str(p).replace(str(Path.home()), "~")


def home_base():
    return Path(os.environ.get("DP_COPIES") or Path.home())


def copy_of(branch):
    for p, b in worktrees():
        if b == branch:
            return Path(p)
    return None


def branch_exists(br):
    return gitr("rev-parse", "--verify", "-q", f"refs/heads/{br}").returncode == 0


def resolve_branch(x):
    """модуль или имя ветки → ветка."""
    if branch_exists(x):
        return x
    if branch_exists(f"feature/{x}"):
        return f"feature/{x}"
    raise DpError(f"ветки {x} (или feature/{x}) нет")


def dirty(path):
    return [l for l in gitr("status", "--porcelain", "--untracked-files=no", cwd=path).stdout.splitlines() if l.strip()]


def journal_commit(path):
    """Журнал dp (docs/plan/<модуль>/) не считается «грязью»: коммитим его своими путями, «<модуль>: журнал dp».
    → список модулей. Остальные изменения остаются и по-прежнему дают отказ."""
    out = gitr("status", "--porcelain", "--untracked-files=all", "--", "docs/plan", cwd=path).stdout
    mods = []
    for l in out.splitlines():
        parts = l[3:].strip().strip('"').split("/")
        if len(parts) >= 4 and parts[:2] == ["docs", "plan"] and parts[2] not in mods:
            mods.append(parts[2])
    for m in mods:
        commit_paths(path, [Path(path) / "docs/plan" / m], f"{m}: журнал dp")
    return mods


def do_merge(path, src, msg, ff=True, trailers=None):
    """merge src в ветку копии path. → (хеш, файлов, 'up-to-date'|'merged'); конфликт → abort + DpError."""
    jm = journal_commit(path)
    if jm:
        print(f"журнал dp закоммичен в {pretty(path)}: {', '.join(jm)}")
    if dirty(path):
        raise DpError(f"копия {pretty(path)} грязная (изменения в отслеживаемых файлах) — отказ")
    before = gitr("rev-parse", "HEAD", cwd=path).stdout.strip()
    args = ["merge", "--no-edit", "-m", msg] + (["-m", session_line()] if session_line() else []) + [x for t in trailers or [] for x in ("-m", t)] + ([] if ff else ["--no-ff"]) + [src]
    r = gitr(*args, cwd=path)
    if r.returncode:
        files = gitr("diff", "--name-only", "--diff-filter=U", cwd=path).stdout.split()
        gitr("merge", "--abort", cwd=path)
        raise DpError(f"конфликт при слиянии {src} в {pretty(path)}, отменено (merge --abort); файлы: {', '.join(files) or gerr(r)}")
    after = gitr("rev-parse", "HEAD", cwd=path).stdout.strip()
    if after == before:
        return after[:7], 0, "up-to-date"
    nfiles = len(gitr("diff", "--name-only", before, after, cwd=path).stdout.split())
    return after[:7], nfiles, "merged"


def cmd_module_new(a):
    mod = a.module
    br = f"feature/{mod}"
    copy = home_base() / f"deltaplan-{mod}"
    if branch_exists(br):
        raise DpError(f"ветка {br} уже есть")
    if copy.exists():
        raise DpError(f"{copy} уже существует")
    if not branch_exists(a.from_):
        raise DpError(f"базовой ветки {a.from_} нет")
    r = gitr("worktree", "add", "-b", br, str(copy), a.from_)
    if r.returncode:
        raise DpError(f"git worktree add: {gerr(r)}")
    global _WT
    _WT = None
    home = copy / "docs/plan" / mod
    ensure_module(mod, home, copy=str(copy).replace(str(Path.home()), "~"), code=a.code)
    add_event(home, None, "note", by_default(a), note=f"модуль заведён от {a.from_}")
    h = commit_paths(copy, [home], f"{mod}: заведён модуль dp (module.json, events.jsonl)")
    print(f"{mod}: {br} от {a.from_} @ {str(copy).replace(str(Path.home()), '~')}, коммит {h}")


