# ---------------------------------------------------------------- CLI

class Parser(argparse.ArgumentParser):
    def error(self, message):
        die(f"{message} ({self.prog} -h)", 2)


def build():
    p = Parser(prog="dp", description="Журнал, карточки задач и приёмка модулей Deltaplan. Справка с примерами — tools/dp.md.",
               formatter_class=argparse.RawDescriptionHelpFormatter,
               epilog="Автор событий: --by или $DP_ROLE. Коды: 0 ок, 1 ошибка/FAIL, 2 аргументы.")
    sp = p.add_subparsers(dest="cmd", required=True, parser_class=Parser, metavar="команда")

    q = sp.add_parser("init", help="завести модуль (module.json); task new делает это сам")
    q.add_argument("module")
    q.add_argument("--plan"); q.add_argument("--contracts"); q.add_argument("--branch"); q.add_argument("--copy")
    q.set_defaults(fn=cmd_init)

    t = sp.add_parser("task", help="карточка задачи: new | show")
    tsp = t.add_subparsers(dest="sub", required=True, parser_class=Parser, metavar="new|show")
    q = tsp.add_parser("new", help="создать карточку")
    q.add_argument("module"); q.add_argument("id")
    q.add_argument("--type", help="dp-engineer|dp-researcher|dp-writer|dp-mechanic")
    q.add_argument("--title"); q.add_argument("--goal"); q.add_argument("--plan-ref", dest="plan_ref", help="раздел плана, напр. §UC-3")
    q.add_argument("--copy"); q.add_argument("--branch")
    q.add_argument("--from", dest="from_", metavar="FILE", help="JSON-карточка (поля поверх шаблона), - = stdin")
    q.add_argument("--contract", action="append", metavar="ИМЯ@ВЕРСИЯ")
    q.add_argument("--scope", action="append", metavar="ПУТЬ"); q.add_argument("--dont-touch", dest="dont_touch", action="append", metavar="ПУТЬ")
    q.add_argument("--test", action="append", metavar="ФИЛЬТР", help="проверка: headless-тесты --filter=ФИЛЬТР, 0 упало")
    q.add_argument("--check", action="append", nargs=3, metavar=("ИМЯ", "CMD", "EXPECT"),
                   help="EXPECT: exit=N | re:<regex> | !re:<regex> | num:<regex с группой> <op>N | tests")
    q.add_argument("--force", action="store_true"); q.add_argument("--by")
    q.set_defaults(fn=cmd_task_new)
    q = tsp.add_parser("show", help="карточка для исполнителя (коротко)")
    q.add_argument("id"); q.add_argument("--json", action="store_true")
    q.set_defaults(fn=cmd_task_show)

    q = sp.add_parser("event", help="событие задачи (или note модуля) в events.jsonl")
    q.add_argument("target", metavar="ID|модуль"); q.add_argument("kind", choices=EVENT_KINDS)
    q.add_argument("--commit", action="append"); q.add_argument("--note"); q.add_argument("--by")
    q.set_defaults(fn=cmd_event)

    q = sp.add_parser("decide", help="решение (или --ask: вопрос пользователю) в decisions.jsonl")
    q.add_argument("module"); q.add_argument("text")
    q.add_argument("--by", help="user|coordinator|main"); q.add_argument("--why"); q.add_argument("--task")
    q.add_argument("--ask", action="store_true", help="открыть вопрос (шлюз) → Qn")
    q.add_argument("--answers", metavar="Qn", help="закрывает вопрос")
    q.add_argument("--date", help=argparse.SUPPRESS)
    q.set_defaults(fn=cmd_decide)

    q = sp.add_parser("accept", help="прогнать проверки карточки → PASS/FAIL, итог в события")
    q.add_argument("id"); q.add_argument("--only", action="append", metavar="ИМЯ")
    q.add_argument("--cwd", help="где запускать (по умолчанию копия задачи, если есть, иначе текущая)")
    q.add_argument("--here", action="store_true", help="в текущей копии (после слияния в ветку модуля)")
    q.add_argument("-j", "--jobs", type=int, default=1); q.add_argument("--commit", action="append")
    q.add_argument("--dry", action="store_true", help="не писать событие")
    q.add_argument("--no-accept", dest="no_accept", action="store_true", help="записать checked, даже если всё PASS")
    q.add_argument("--no-review", dest="no_review", action="store_true",
                   help="engineer/researcher: accepted без ревью (по умолчанию PASS → checked, ждёт dp-reviewer)")
    q.add_argument("--full", action="store_true", help="пути логов и для PASS"); q.add_argument("--by")
    q.set_defaults(fn=cmd_accept)

    q = sp.add_parser("report", help="отчёт исполнителя: dp report ID < r.json | --show | --template")
    q.add_argument("id", nargs="?"); q.add_argument("file", nargs="?")
    q.add_argument("--show", action="store_true"); q.add_argument("--template", action="store_true")
    q.add_argument("--full", action="store_true"); q.add_argument("--by")
    q.set_defaults(fn=cmd_report)

    q = sp.add_parser("review", help="вердикт ревьюера: dp review ID --verdict accept|rework --from r.json | --note … | --show | --template")
    q.add_argument("id", nargs="?"); q.add_argument("--verdict", choices=VERDICTS)
    q.add_argument("--from", dest="from_", metavar="FILE", help="JSON ревью (dp review --template), - = stdin")
    q.add_argument("--note", help="короткое ревью без файла (замечаний нет) или summary к --from")
    q.add_argument("--show", action="store_true"); q.add_argument("--template", action="store_true")
    q.add_argument("--full", action="store_true"); q.add_argument("--by")
    q.set_defaults(fn=cmd_review)

    q = sp.add_parser("status", help="сводка: задачи, ветки, тишина, вопросы пользователю")
    q.add_argument("module", nargs="?"); q.add_argument("--full", action="store_true", help="и закрытые задачи")
    q.add_argument("--stale", type=int, default=40, metavar="МИН", help="порог «тихо» (40)")
    q.set_defaults(fn=cmd_status)

    q = sp.add_parser("log", help="последние события модуля или задачи")
    q.add_argument("target", metavar="ID|модуль"); q.add_argument("-n", type=int, default=10)
    q.add_argument("--full", action="store_true")
    q.set_defaults(fn=cmd_log)

    q = sp.add_parser("plan", help="оглавление плана или раздел (номер из оглавления или начало заголовка)")
    q.add_argument("target", metavar="модуль|файл.md"); q.add_argument("section", nargs="?")
    q.add_argument("--contracts", action="store_true", help="файл контрактов модуля вместо плана")
    q.add_argument("--depth", type=int, default=3, help="уровни заголовков в оглавлении (3)")
    q.add_argument("--max", type=int, default=150, help="строк раздела (150; 0 — всё)")
    q.set_defaults(fn=cmd_plan)

    q = sp.add_parser("render", help="собрать md-журнал docs/plan/<модуль>_progress.md")
    q.add_argument("module"); q.add_argument("--out", help="путь или - (stdout)"); q.add_argument("--force", action="store_true")
    q.set_defaults(fn=cmd_render)
    return p


def main():
    a = build().parse_args()
    try:
        a.fn(a)
    except DpError as e:
        die(str(e))
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
